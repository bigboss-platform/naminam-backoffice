# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.

# MongoDB (local Docker: docker compose up -d)
MONGODB_URI=mongodb://naminam:naminam-dev@localhost:27017/?authSource=admin
MONGODB_DB=naminam

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string

# First admin account, created by `npm run seed` (change the password after the first login)
ADMIN_EMAIL=admin@naminam.com
ADMIN_NAME=Ñami Ñam
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: refresh the public site right after every save (landing-app /api/revalidate).
# The secret must equal REVALIDATE_SECRET in naminam/landing-app/.env.local
LANDING_REVALIDATE_URL=http://localhost:3000/api/revalidate
LANDING_REVALIDATE_SECRET=replace-with-the-same-secret-as-the-landing
