# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.

# DEMO MODE (client presentation, no database): demo data in memory + demo login
# (demo@santanita.pe / santanita2026, shown on /login). Also on automatically when
# MONGODB_URI is empty — that is how the Vercel demo runs. Changes reset on restart.
DEMO_MODE=false

# MongoDB (local Docker: docker compose up -d)
MONGODB_URI=mongodb://santanita:santanita-dev@localhost:27018/?authSource=admin
MONGODB_DB=santanita

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string

# First admin account, created by `npm run seed` (change the password after the first login)
ADMIN_EMAIL=antojitos.santanita@gmail.com
ADMIN_NAME=Santanita
ADMIN_PASSWORD=replace-with-a-strong-password

# Santanita MVP: the public site does not read the database yet, so leave these empty.
LANDING_REVALIDATE_URL=
LANDING_REVALIDATE_SECRET=
